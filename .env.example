# Public Supabase settings. Safe to expose in the browser, but this site
# only uses them on the server. Do not put the service role key in a
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site URL used for canonical links, the sitemap, and JSON-LD.
# PLACEHOLDER site URL - confirm with client
NEXT_PUBLIC_SITE_URL=https://buzzboxxpxv.com

# Stripe is intentionally not configured. See lib/payments.ts.
